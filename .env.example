# Copy to .env next to server.mjs and fill in. Values set in the hosting
# environment (Hostinger hPanel → Node.js app → Environment variables) win.

# Password for the /admin CMS portal (REQUIRED for the admin to work).
JALI_ADMIN_PASSWORD=change-me-to-something-strong

# Where the CMS content + visit data JSON files live. Keep this OUTSIDE the
# folder that gets replaced on each deploy so edits & stats survive redeploys.
# Default: ./data next to server.mjs
# JALI_DATA_DIR=/home/USER/jali-data

# Port is provided by the host automatically; only set for local runs.
# PORT=3000
